PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/parkflow
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173

# Optional: use another Nominatim-compatible search provider if needed
GEOCODER_SEARCH_URL=https://nominatim.openstreetmap.org/search

PARKFLOW_SERVICE_FEE=15

# Optional: create an admin account when running the seed script
PARKFLOW_ADMIN_EMAIL=
PARKFLOW_ADMIN_PASSWORD=


# Optional: create a demo driver account when seeding
PARKFLOW_DEMO_EMAIL=
PARKFLOW_DEMO_PASSWORD=



# Local demo simulations are disabled in production; configure an authenticated operator feed.
OCCUPANCY_PROVIDER=simulation
OCCUPANCY_WEBHOOK_SECRET=

# Optional: configure password-reset email delivery with a verified Resend sender
RESEND_API_KEY=
EMAIL_FROM=
