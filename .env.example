PORT=5000
MONGODB_URI=
JWT_SECRET=
# Use a separate random secret of at least 32 characters to sign booking QR codes.
QR_SIGNING_SECRET=
CLIENT_URL=http://localhost:5173

# Optional: use another Nominatim-compatible search provider if needed.
GEOCODER_SEARCH_URL=https://nominatim.openstreetmap.org/search
PARKING_SEARCH_URL=https://overpass-api.de/api/interpreter
ROUTING_SERVICE_URL=https://router.project-osrm.org/route/v1/driving

PARKFLOW_SERVICE_FEE=15

# Optional: create an admin account when running the seed script.
PARKFLOW_ADMIN_EMAIL=
PARKFLOW_ADMIN_PASSWORD=

# Optional: create a demo driver account when seeding.
PARKFLOW_DEMO_EMAIL=
PARKFLOW_DEMO_PASSWORD=

# Production defaults to manual occupancy until an authenticated operator feed is configured.
OCCUPANCY_PROVIDER=manual
OCCUPANCY_WEBHOOK_SECRET=

# Optional: password-reset email delivery using a verified Resend sender.
RESEND_API_KEY=
EMAIL_FROM=
